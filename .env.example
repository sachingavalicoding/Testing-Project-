# Copy to .env and fill in. Never commit .env.

PORT=8080
DB_PATH=./data/stock-iq.db

# Upstox app (your brother's account). Create the app at https://account.upstox.com/developer/apps
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8080/api/auth/upstox/callback
# Optional: paste a token you already have (it expires every day around 3:30 AM IST).
UPSTOX_ACCESS_TOKEN=

# Price feed: "upstox" (needs a token) or "mock" (fake prices for testing the app offline).
FEED=mock

# Money rules
CAPITAL=30000
DAILY_LOSS_CAP=600
MAX_OPEN_POSITIONS=3
RISK_PER_TRADE=200
# Skip entries in shares that already moved more than this % today
MAX_DAY_MOVE_PCT=3
# Same limit for the Mid and Small lists, which move more in a day
MAX_DAY_MOVE_PCT_MID=6
MAX_DAY_MOVE_PCT_SMALL=12
# Square off all intraday positions at this IST time
SQUARE_OFF_TIME=15:15

# REAL MONEY SAFETY LOCK. Leave false. Real orders are impossible while this is false.
REAL_TRADING_ENABLED=false
